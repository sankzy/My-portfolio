---
layout: layouts/base.njk
title: Projects | Sanke Silas
description: Full-stack web projects and engineering work by Sanke Silas, with live demos and source code.
permalink: projects.html
mainClass: main-content container
---

<h1 class="page-title">Featured Proof of Work</h1>

{% for project in projects %}
<section class="project-card" aria-labelledby="{{ project.slug }}-title">
    {% set image = project.slug | projectImage %}
    {% if image %}
    <img
        class="project-image"
        src="{{ image }}"
        alt="{{ project.imageAlt or ('Screenshot of the ' ~ project.title ~ ' website') }}"
        width="1280"
        height="800"
        loading="lazy"
    />
    {% endif %}
    <div class="project-heading">
        <h2 id="{{ project.slug }}-title">{{ project.title }}</h2>
        {% if project.badge %}
        <span class="project-badge">{{ project.badge }}</span>
        {% endif %}
    </div>
    {% if project.stack %}
    <p><strong>Stack:</strong> {{ project.stack | join(", ") }}</p>
    {% endif %}
    {% if project.focus %}
    <p><strong>Focus:</strong> {{ project.focus }}</p>
    {% endif %}
    <p>{{ project.description }}</p>
    {% if project.liveUrl or project.repoUrl or project.extraLinks or project.repoNote %}
    <div class="project-actions">
        {% if project.liveUrl %}
        <a href="{{ project.liveUrl }}" target="_blank" rel="noopener noreferrer" class="btn">
            {% icon "solid/up-right-from-square" %} Live Demo
        </a>
        {% endif %}
        {% for link in project.extraLinks %}
        <a href="{{ link.url }}" target="_blank" rel="noopener noreferrer" class="btn-outline">
            {{ link.label }}
        </a>
        {% endfor %}
        {% if project.repoUrl %}
        <a
            href="{{ project.repoUrl }}"
            target="_blank"
            rel="noopener noreferrer"
            class="{{ 'btn-outline' if project.liveUrl else 'btn' }}"
        >
            {% icon "brands/github" %} Code
        </a>
        {% endif %}
        {% if project.repoNote %}
        <span class="project-note">{{ project.repoNote }}</span>
        {% endif %}
    </div>
    {% endif %}
</section>
{% endfor %}
